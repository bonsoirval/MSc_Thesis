  keywords = {Automated Pattern Recognition,Computer Vision,Feature extraction,Image processing,Image Processing,Machine learning,Machine Learning,Neurospora crassa,Pattern recognition,Plant Pathology,Principal component analysis,Support vector machine}
}

@article{liuPlantDiseasesPests2021a,
